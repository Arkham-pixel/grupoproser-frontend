# Copiar a .env (desarrollo) o usar en Coolify al desplegar el frontend.
# Solo variables VITE_* se incluyen en el build de Vite.
# Mismas claves en local y producción; cambian los valores.

# Local
VITE_API_BASE_URL=http://localhost:3000
VITE_VIDEOPERITAJE_PUBLIC_URL=https://arnaldbackend.grupoproser.com.co
# * | all | open = todos los autenticados; o lista de logins/cédulas
VITE_LOGINS_VIDEOPERITAJE=*
VITE_LOGINS_VIDEOPERITAJE_ADMIN=1065012991
VITE_VIDEOPERITAJE_EN_CAT=true

# Coolify (.env.production o variables del servicio):
# VITE_API_BASE_URL=https://arnaldbackend.grupoproser.com.co
# VITE_UPLOADS_BASE_URL=https://arnaldbackend.grupoproser.com.co
# VITE_VIDEOPERITAJE_PUBLIC_URL=https://arnaldbackend.grupoproser.com.co
# VITE_LOGINS_VIDEOPERITAJE=*
# VITE_LOGINS_VIDEOPERITAJE_ADMIN=1065012991
# VITE_VIDEOPERITAJE_EN_CAT=true
# Front público: https://arnald.grupoproser.com.co
# Archivos nuevos van a S3 vía API (STORAGE_DRIVER=s3 en backend); no guardar en disco del servidor.

VITE_GOOGLE_MAPS_API_KEY=
